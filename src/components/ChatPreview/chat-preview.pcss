.chat-preview {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 12px 16px;
  box-sizing: border-box;
  border-bottom: 1px solid var(--color-border);
  cursor: pointer;
}

.chat-preview:hover {
  background-color: var(--color-background);
}

.chat-preview__avatar {
  display: grid;
  flex: 0 0 48px;
  width: 48px;
  height: 48px;
  place-items: center;
  border-radius: 50%;
  background-color: var(--color-secondary);
  color: var(--color-primary);
  font-size: 14px;
  font-weight: 600;
}

.chat-preview__content {
  min-width: 0;
  flex: 1;
}

.chat-preview__header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.chat-preview__name {
  min-width: 0;
  overflow: hidden;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 15px;
  font-weight: 600;
}

.chat-preview__time {
  flex-shrink: 0;
  margin-left: auto;
  color: var(--color-text-secondary);
  font-size: 12px;
}

.chat-preview__message {
  margin: 0;
  overflow: hidden;
  color: var(--color-text-secondary);
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
}
