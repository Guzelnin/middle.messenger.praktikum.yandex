.message-form {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px;
  border-bottom: 1px solid var(--color-border);
  background-color: var(--color-background);
}

.message-form__field {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4px;
}

.message-form__attach-button,
.message-form__send {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  flex-shrink: 0;
  border: none;
  border-radius: 50%;
  background-color: var(--color-primary);
  cursor: pointer;
}

.message-form__textarea {
  min-width: 0;
  width: 100%;
  height: 24px;
  max-height: 48px;
  padding: 8px 12px;
  box-sizing: border-box;
  overflow-y: auto;
  resize: none;
  border: 1px solid #ccc;
  border-radius: 8px;
  outline: none;
  color: var(--color-text);
  font-size: 14px;
  line-height: 24px;
}
