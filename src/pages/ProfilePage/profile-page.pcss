.profile-page {
  min-height: 100vh;
  padding: 24px;
  box-sizing: border-box;
  background-color: var(--color-background);
}

.profile-page__back-link {
  display: inline-block;
  color: var(--color-text-secondary);
  text-decoration: none;
}

.profile-page__back-link:hover {
  color: var(--color-primary);
}

.profile-page__card {
  display: flex;
  width: min(100%, 420px);
  margin: 32px auto 0;
  padding: 32px;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  background-color: var(--color-surface);
}

.profile-page__avatar {
  display: grid;
  width: 96px;
  height: 96px;
  place-items: center;
  border-radius: 50%;
  background-color: var(--color-secondary);
  color: var(--color-primary);
  font-size: 32px;
  font-weight: 600;
  overflow: hidden;
  cursor: pointer;
  padding: 0;
  border: 0;
}

.profile-page__avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-modal[hidden] {
  display: none;
}

.avatar-modal {
  position: fixed;
  z-index: 10;
  inset: 0;
  display: grid;
  padding: 20px;
  place-items: center;
  background: rgb(0 0 0 / 45%);
}

.avatar-modal__dialog {
  position: relative;
  display: flex;
  width: min(100%, 360px);
  min-height: 230px;
  padding: 32px 24px 24px;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-radius: 12px;
  background-color: var(--color-surface);
  box-shadow: 0 12px 40px rgb(0 0 0 / 20%);
}

.avatar-modal__close {
  position: absolute;
  top: 8px;
  right: 12px;
  border: 0;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 24px;
  cursor: pointer;
}

.avatar-modal__title {
  margin: 0;
  color: var(--color-text);
  font-size: 20px;
  text-align: center;
}

.avatar-modal__file-label {
  position: relative;
  max-width: 100%;
  color: var(--color-primary);
  overflow-wrap: anywhere;
  text-align: center;
  text-decoration: underline;
  cursor: pointer;
}

.avatar-modal__file-input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.avatar-modal__error {
  max-width: 100%;
  margin: -12px 0 0;
  color: var(--color-error);
  font-size: 13px;
  line-height: 18px;
  overflow-wrap: anywhere;
  text-align: center;
}

.avatar-modal__submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.profile-page__name {
  margin: 16px 0 24px;
  color: var(--color-text);
  font-size: 22px;
  font-weight: 600;
}

.profile-page__details {
  width: 100%;
  margin: 0;
}

.profile-page__detail {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid var(--color-border);
}

.profile-page__label,
.profile-page__value {
  margin: 0;
  font-size: 14px;
}

.profile-page__label {
  color: var(--color-text-secondary);
}

.profile-page__value {
  overflow-wrap: anywhere;
  color: var(--color-text);
  text-align: right;
}

.profile-page__actions {
  display: flex;
  width: 100%;
  margin-top: 24px;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.profile-page__form-title {
  margin: 0 0 24px;
  color: var(--color-text);
  font-size: 22px;
  font-weight: 600;
  text-align: center;
}

.profile-page__form {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 16px;
}

.profile-page__field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.profile-page__field-label {
  color: var(--color-text-secondary);
  font-size: 14px;
}

.profile-page__form-actions {
  display: flex;
  margin-top: 8px;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.profile-page__form-actions > .button {
  align-self: center;
  text-align: center;
}

.profile-page__action {
  text-align: center;
  color: var(--color-primary);
  text-decoration: none;
}

.profile-page__action--danger {
  background-color: transparent;
  color: var(--color-error);
}
