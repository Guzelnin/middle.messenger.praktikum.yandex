.profile-page {
  min-height: 100vh;
  padding: 24px;
  box-sizing: border-box;
  background-color: var(--color-background);
}

.profile-page__back-button {
  color: var(--color-text-secondary);
  background-color: var(--color-surface);
}

.profile-page__back-button:hover {
  color: var(--color-primary);
}

.profile-page__card {
  display: flex;
  width: min(100%, 420px);
  margin: 32px auto 0;
  padding: 32px;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  background-color: var(--color-surface);
}

.profile-page__avatar {
  display: grid;
  width: 96px;
  height: 96px;
  place-items: center;
  border-radius: 50%;
  background-color: var(--color-secondary);
  color: var(--color-primary);
  font-size: 32px;
  font-weight: 600;
}

.profile-page__name {
  margin: 16px 0 24px;
  color: var(--color-text);
  font-size: 22px;
  font-weight: 600;
}

.profile-page__details {
  width: 100%;
  margin: 0;
}

.profile-page__detail {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid var(--color-border);
}

.profile-page__label,
.profile-page__value {
  margin: 0;
  font-size: 14px;
}

.profile-page__label {
  color: var(--color-text-secondary);
}

.profile-page__value {
  overflow-wrap: anywhere;
  color: var(--color-text);
  text-align: right;
}

.profile-page__actions {
  display: flex;
  width: 100%;
  margin-top: 24px;
  flex-direction: column;
  gap: 8px;
}

.profile-page__form-title {
  margin: 0 0 24px;
  color: var(--color-text);
  font-size: 22px;
  font-weight: 600;
  text-align: center;
}

.profile-page__form {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 16px;
}

.profile-page__field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.profile-page__field-label {
  color: var(--color-text-secondary);
  font-size: 14px;
}

.profile-page__form-actions {
  display: flex;
  margin-top: 8px;
  flex-direction: column;
  gap: 8px;
}

.profile-page__form-actions .button {
  width: 100%;
  text-align: center;
}

.profile-page__action {
  width: 100%;
  background-color: var(--color-secondary);
  color: var(--color-text);
  text-decoration: none;
}

.profile-page__action--danger {
  background-color: transparent;
  color: var(--color-error);
}
