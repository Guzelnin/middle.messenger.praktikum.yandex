<main class="profile-page">
  <button class="button profile-page__back-button" type="button">← К чатам</button>

  <section class="profile-page__card" aria-labelledby="profile-name">
    <div class="profile-page__avatar" role="img" aria-label="Аватар {{user.name}}">
      {{user.initials}}
    </div>
    <h1 class="profile-page__name" id="profile-name">{{user.name}}</h1>

    <dl class="profile-page__details">
      <div class="profile-page__detail">
        <dt class="profile-page__label">Почта</dt>
        <dd class="profile-page__value">{{user.email}}</dd>
      </div>
      <div class="profile-page__detail">
        <dt class="profile-page__label">Логин</dt>
        <dd class="profile-page__value">{{user.login}}</dd>
      </div>
      <div class="profile-page__detail">
        <dt class="profile-page__label">Имя</dt>
        <dd class="profile-page__value">{{user.firstName}}</dd>
      </div>
      <div class="profile-page__detail">
        <dt class="profile-page__label">Фамилия</dt>
        <dd class="profile-page__value">{{user.lastName}}</dd>
      </div>
      <div class="profile-page__detail">
        <dt class="profile-page__label">Телефон</dt>
        <dd class="profile-page__value">{{user.phone}}</dd>
      </div>
    </dl>

    <div class="profile-page__actions">
      <a class="button profile-page__action" href="/profile/edit">Изменить данные</a>
      <a class="button profile-page__action" href="/profile/password">Изменить пароль</a>
      <button class="button profile-page__action profile-page__action--danger" type="button">Выйти</button>
    </div>
  </section>
</main>
