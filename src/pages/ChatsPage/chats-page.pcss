.home-page {
  display: flex;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  flex-direction: column;
}

.page-index {
  display: flex;
  min-height: 64px;
  padding: 12px 20px;
  box-sizing: border-box;
  align-items: center;
  gap: 24px;
  border-bottom: 1px solid var(--color-border);
  background-color: var(--color-surface);
}

.page-index__title {
  margin: 0;
  flex-shrink: 0;
  color: var(--color-text);
  font-size: 16px;
  font-weight: 600;
}

.page-index__list {
  display: flex;
  margin: 0;
  padding: 0;
  flex-wrap: wrap;
  gap: 8px 16px;
  list-style: none;
}

.page-index__item a {
  color: var(--color-text-secondary);
  font-size: 13px;
  text-decoration: none;
}

.page-index__item a:hover {
  color: var(--color-primary);
}

.chats-page {
  display: grid;
  min-height: 0;
  flex: 1;
  width: 100%;
  grid-template-columns: 300px 2fr;
}

.sidebar {
  display: flex;
  flex-direction: column;
  min-height: 0;
  box-sizing: border-box;
}

.sidebar__profile {
  display: flex;
  justify-content: flex-end;
  flex-shrink: 0;
  padding: 8px;
}

.sidebar__profile-link {
  color: var(--color-text-secondary);
  text-decoration: none;
}

.chats {
  flex: 1;
  min-height: 0;
  margin: 0;
  padding: 0;
  overflow-y: auto;
  list-style: none;
}

.chat {
  display: grid;
  grid-template-rows: 72px minmax(0, 1fr) 72px;
  min-height: 0;
  min-width: 0;
  border-left: 1px solid var(--color-border);
}

.chat--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat__empty-state {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: 14px;
  text-align: center;
}

.chat__messages {
  display: flex;
  min-height: 0;
  padding: 24px;
  flex-direction: column;
  gap: 12px;
  overflow-y: auto;
}

.chat__date {
  align-self: center;
  color: var(--color-text-secondary);
  font-size: 12px;
}

.message {
  max-width: min(75%, 440px);
  padding: 10px 14px;
  align-self: flex-start;
  border-radius: 12px 12px 12px 2px;
  background-color: var(--color-background);
}

.message--own {
  align-self: flex-end;
  border-radius: 12px 12px 2px 12px;
  background-color: var(--color-secondary);
}

.message__text {
  margin: 0 0 4px;
  color: var(--color-text);
  font-size: 14px;
}

.message__time {
  display: block;
  color: var(--color-text-secondary);
  font-size: 11px;
  text-align: right;
}

@media (max-width: 760px) {
  .page-index {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .chats-page {
    grid-template-columns: minmax(220px, 40%) 1fr;
  }
}
