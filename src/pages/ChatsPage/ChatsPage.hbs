<main class="home-page">
  <nav class="page-index" aria-label="Страницы приложения">
    <h1 class="page-index__title">Страницы проекта</h1>
    <ul class="page-index__list">
      <li class="page-index__item"><a href="/messenger">Чаты</a></li>
      <li class="page-index__item"><a href="/">Вход</a></li>
      <li class="page-index__item"><a href="/sign-up">Регистрация</a></li>
      <li class="page-index__item"><a href="/settings">Профиль</a></li>
      <li class="page-index__item">
        <a href="/profile/edit">Изменение данных</a>
      </li>
      <li class="page-index__item">
        <a href="/profile/password">Изменение пароля</a>
      </li>
      <li class="page-index__item"><a href="/404">Ошибка 404</a></li>
      <li class="page-index__item"><a href="/500">Ошибка 500</a></li>
    </ul>
  </nav>

  <div class="chats-page">
    <div class="sidebar">
      <div class="sidebar__profile">
        <a class="link sidebar__profile-link" href="/settings">Профиль</a>
      </div>

      <button
        class="button button--secondary sidebar__create-chat"
        type="button"
        data-action="open-create-chat"
      >
        Создать чат
      </button>

      {{{ChatSearch}}} {{{Divider}}}

      <ul class="chats">
        {{#each chats}} {{{ChatPreview chat=this}}} {{/each}}
      </ul>
    </div>
    <div class="chat {{#unless activeChat}}chat--empty{{/unless}}">
      {{#if activeChat}} {{{ChatHeader title=activeChat.title
      avatarInitials=activeChat.avatarInitials id=activeChat.id}}}

      <section class="chat__messages" aria-label="Сообщения">
        <div class="chat__date">Сегодня</div>
        {{#each messages}} {{{Message message=this}}} {{/each}}
      </section>

      {{{MessageForm}}} {{else}}
      <p class="chat__empty-state">Выберите чат, чтобы отправить сообщение</p>
      {{/if}}
    </div>
  </div>

  <div class="chat-modal" data-add-user-modal hidden>
    <form
      class="chat-modal__dialog"
      data-form="add-user"
      role="dialog"
      aria-modal="true"
      aria-labelledby="add-user-title"
    >
      <button
        class="chat-modal__close"
        type="button"
        data-action="close-add-user"
        aria-label="Закрыть"
      >
        ×
      </button>
      <h2 class="chat-modal__title" id="add-user-title">
        Добавить пользователя
      </h2>
      <label class="chat-modal__label" for="chat-user-login"
        >Введите логин пользователя</label
      >
      <input
        class="input"
        id="chat-user-login"
        name="login"
        type="text"
        autocomplete="off"
        required
      />
      <button class="button button--primary" type="submit">
        Добавить пользователя
      </button>
      <p class="chat-modal__error" data-modal-error role="alert" hidden></p>
    </form>
  </div>

  <div class="chat-modal" data-create-chat-modal hidden>
    <form
      class="chat-modal__dialog"
      data-form="create-chat"
      role="dialog"
      aria-modal="true"
      aria-labelledby="create-chat-title"
    >
      <button
        class="chat-modal__close"
        type="button"
        data-action="close-create-chat"
        aria-label="Закрыть"
      >
        ×
      </button>
      <h2 class="chat-modal__title" id="create-chat-title">
        Создать групповой чат
      </h2>
      <label class="chat-modal__label" for="new-chat-title"
        >Название чата</label
      >
      <input
        class="input"
        id="new-chat-title"
        name="title"
        type="text"
        maxlength="80"
        required
      />
      <button class="button button--primary" type="submit">Создать</button>
      <p class="chat-modal__error" data-modal-error role="alert" hidden></p>
    </form>
  </div>

  <div class="chat-modal" data-remove-user-modal hidden>
    <form
      class="chat-modal__dialog"
      data-form="remove-user"
      role="dialog"
      aria-modal="true"
      aria-labelledby="remove-user-title"
    >
      <button
        class="chat-modal__close"
        type="button"
        data-action="close-remove-user"
        aria-label="Закрыть"
      >
        ×
      </button>
      <h2 class="chat-modal__title" id="remove-user-title">
        Удалить пользователя из чата
      </h2>
      <label class="chat-modal__label" for="chat-user-to-remove"
        >Пользователь</label
      >
      <select
        class="input"
        id="chat-user-to-remove"
        name="userId"
        required
      ></select>
      <button class="button button--primary" type="submit" disabled>
        Удалить пользователя
      </button>
      <p class="chat-modal__error" data-modal-error role="alert" hidden></p>
    </form>
  </div>

  <div class="chat-modal" data-delete-chat-modal hidden>
    <form
      class="chat-modal__dialog"
      data-form="delete-chat"
      role="dialog"
      aria-modal="true"
      aria-labelledby="delete-chat-title"
    >
      <button
        class="chat-modal__close"
        type="button"
        data-action="close-delete-chat"
        aria-label="Закрыть"
      >
        ×
      </button>
      <h2 class="chat-modal__title" id="delete-chat-title">
        Вы хотите удалить чат?
      </h2>
      <button class="button button--primary" type="submit">Удалить чат</button>
      <p class="chat-modal__error" data-modal-error role="alert" hidden></p>
    </form>
  </div>
</main>
