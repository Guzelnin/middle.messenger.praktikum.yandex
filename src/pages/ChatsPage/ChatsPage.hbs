<main class="home-page">
  <nav class="page-index" aria-label="Страницы приложения">
    <h1 class="page-index__title">Страницы проекта</h1>
    <ul class="page-index__list">
      <li class="page-index__item"><a href="/">Чаты</a></li>
      <li class="page-index__item"><a href="/sign-in">Вход</a></li>
      <li class="page-index__item"><a href="/sign-up">Регистрация</a></li>
      <li class="page-index__item"><a href="/profile">Профиль</a></li>
      <li class="page-index__item"><a href="/profile/edit">Изменение данных</a></li>
      <li class="page-index__item"><a href="/profile/password">Изменение пароля</a></li>
      <li class="page-index__item"><a href="/404">Ошибка 404</a></li>
      <li class="page-index__item"><a href="/500">Ошибка 500</a></li>
    </ul>
  </nav>

  <div class="chats-page">
    <div class="sidebar">
      <div class="sidebar__profile">
        <a class="link sidebar__profile-link" href="/profile">Профиль</a>
      </div>

      {{> ChatSearch}}

      {{> Divider}}

      <ul class="chats">
        {{#each chats}}
        {{> ChatPreview this}}
        {{/each}}
      </ul>
    </div>
    <div class="chat {{#unless activeChat}}chat--empty{{/unless}}">
      {{#if activeChat}}
        {{> ChatHeader activeChat}}

        <section class="chat__messages" aria-label="Сообщения">
          <div class="chat__date">Сегодня</div>
          {{#each messages}}
          {{> Message this}}
          {{/each}}
        </section>

        {{> MessageForm}}
      {{else}}
        <p class="chat__empty-state">Выберите чат, чтобы отправить сообщение</p>
      {{/if}}
    </div>
  </div>
</main>
