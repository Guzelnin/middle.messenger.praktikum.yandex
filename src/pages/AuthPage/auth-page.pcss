.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-page__form {
  display: grid;
  grid-template-rows: auto 1fr auto;
  width: 340px;
  min-height: 300px;
  height: fit-content;
  padding: 24px;
  box-sizing: border-box;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  background-color: var(--color-surface);
  gap: 8px;
}

.auth-page__title {
  margin: 0;
  color: var(--color-text);
  font-size: 22px;
  font-weight: 600;
  text-align: center;
}

.auth-page__form-fields {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.auth-page__form-field {
  display: flex;
  width: 100%;
  flex-direction: column;
}

.auth-page .form-field-error {
  height: 20px;
  margin-top: 4px;
  line-height: 8px;
}

.auth-page .form-field-error:empty {
  display: block;
  visibility: hidden;
}

.auth-page__buttons {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
