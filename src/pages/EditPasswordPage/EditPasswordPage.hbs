<main class="profile-page">
  <a class="link profile-page__back-link" href="/profile">← Назад в профиль</a>

  <section class="profile-page__card" aria-labelledby="edit-password-title">
    <h1 class="profile-page__form-title" id="edit-password-title">Изменить пароль</h1>

    <form class="profile-page__form">
      <label class="profile-page__field" for="current-password">
        <span class="profile-page__field-label">Текущий пароль</span>
        <input class="input" id="current-password" name="oldPassword" type="password" autocomplete="current-password" />
      </label>
      <label class="profile-page__field" for="new-password">
        <span class="profile-page__field-label">Новый пароль</span>
        <input class="input" id="new-password" name="newPassword" type="password" autocomplete="new-password" />
      </label>
      <label class="profile-page__field" for="repeat-password">
        <span class="profile-page__field-label">Повторите новый пароль</span>
        <input class="input" id="repeat-password" name="repeatPassword" type="password" autocomplete="new-password" />
      </label>

      <div class="profile-page__form-actions">
        <button class="button button--primary" type="button">Сохранить пароль</button>
        <a class="link" href="/profile">Отмена</a>
      </div>
    </form>
  </section>
</main>
