.server-error-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16px;
}

.server-error-page__code {
  margin: 0;
  color: var(--color-primary);
  font-size: 150px;
}

.server-error-page__message {
  margin: 0;
  color: var(--color-text);
  font-size: 16px;
  font-weight: 400;
}

.server-error-page__home-link {
  text-decoration: none;
}
