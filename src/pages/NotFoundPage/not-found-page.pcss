.not-found-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16px;
}

.not-found-page__error-code {
  color: var(--color-primary);
  font-size: 150px;
  margin: 0;
}

.not-found-page__error-message {
  font-size: 14px;
  margin: 0;
}

.not-found-page__link-return {
  align-self: center;
  text-decoration: none;
}
