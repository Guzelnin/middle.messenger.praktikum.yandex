{
  "name": "messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "prebuild": "tsc --noEmit",
    "build": "npm run prebuild && vite build",
    "preview": "vite preview",
    "lint": "npx stylelint src/**/*.pcss && npx eslint \"src/**/*.{js,ts,mjs,html,hbs}\"",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "check": "npm run build && npm run lint && npm run format"
  },
  "lint-staged": {
    "*.{js,ts,mjs,html,hbs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{pcss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "postcss-import": "^16.2.0",
    "postcss-nesting": "^14.0.3",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "handlebars": "^4.7.9"
  }
}
